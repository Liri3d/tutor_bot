BOT_TOKEN=ВАШ_ТОКЕН_ОТ_BOTFATHER
TUTOR_TELEGRAM_ID=123456789  # ID репетитора (используй @userinfobot)

# JWT для аутентификации в веб-API
# Сгенерируйте случайный ключ: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=ВАШ_СЕКРЕТНЫЙ_КЛЮЧ_ДЛЯ_JWT_32_СИМВОЛА

# Время жизни JWT токена в минутах
JWT_ACCESS_TOKEN_EXPIRE=30

# URL фронтенда для CORS
CORS_ORIGINS=http://localhost:8000,http://localhost:3000

# Окружение: development или production
ENVIRONMENT=development
